# Copy to .env for local development. On Netlify, set these under Site configuration > Environment variables.

# AI parsing (https://console.anthropic.com). Without it, people can still enter items by hand.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Email (https://www.brevo.com, free plan: 300 emails/day)
BREVO_API_KEY=
SENDER_EMAIL=zakah@yourdomain.com
SENDER_NAME=Zakah Assistant
# The Brevo contact list id for the Ramadan mailing list
BREVO_LIST_ID=
# Optional: a Brevo double opt-in template id. When set, people confirm by email before joining the list.
BREVO_DOI_TEMPLATE_ID=

# Links in the email
FUNDRAISER_URL=
ORGANISER_NAME=Wahaj
SITE_URL=https://your-site.netlify.app

# Optional Cloudflare Turnstile secret (pair with turnstileSiteKey in public/config.js)
TURNSTILE_SECRET=

# Optional fallback metal prices (per gram, GBP) used if the live price feed is down
# FALLBACK_GOLD_GBP_PER_GRAM=94.5
# FALLBACK_SILVER_GBP_PER_GRAM=1.18
# FALLBACK_PRICES_DATE=2026-11-15
